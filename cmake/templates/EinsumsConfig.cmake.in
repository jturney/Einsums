cmake_policy(VERSION 3.22)

# Forward EINSUMS_* cache variables
include("${CMAKE_CURRENT_LIST_DIR}/EinsumsCacheVariables.cmake")

# include einsums cmake utilities
include("${CMAKE_CURRENT_LIST_DIR}/EinsumsMacros.cmake")

# Find the installation root.
get_filename_component(_einsums_root_dir "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)

list(APPEND CMAKE_PREFIX_PATH "${_einsums_root_dir}/lib")

# include external targets
# include exported targets
include("${CMAKE_CURRENT_LIST_DIR}/EinsumsInternalTargets.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/EinsumsTargets.cmake")

# Whether this installation can host stages and extension modules.
#
# Shared-graph capture requires exactly one libEinsums per world: the capture
# context is thread-local state INSIDE the library, so a module that absorbed
# its own static copy gets a second, private context, and nodes it emits land in
# a graph nobody executes.
#
# That is a constraint on STAGE MODULES, not on every consumer. An ordinary C++
# program linking a static libEinsums has exactly one copy and is fine, and the
# project itself builds static under EINSUMS_WITH_COVERAGE. So report the fact,
# and only refuse when the caller says it needs what a static build cannot give:
#
#     find_package(Einsums REQUIRED COMPONENTS stages)
#
if(TARGET Einsums::Einsums)
  get_target_property(_einsums_lib_type Einsums::Einsums TYPE)
  if(_einsums_lib_type STREQUAL "STATIC_LIBRARY")
    set(Einsums_IS_SHARED FALSE)
  else()
    set(Einsums_IS_SHARED TRUE)
  endif()
  unset(_einsums_lib_type)

  if(NOT Einsums_IS_SHARED)
    if("stages" IN_LIST Einsums_FIND_COMPONENTS)
      message(
        FATAL_ERROR
          "This Einsums installation provides only a STATIC libEinsums, so it cannot host stages "
          "or extension modules.\n"
          "Shared-graph capture keeps its capture context in thread-local state inside the "
          "library, so a module with its own absorbed copy gets a second, private context and the "
          "captured graph silently loses whatever that module emitted.\n"
          "Rebuild and install Einsums with BUILD_SHARED_LIBS=ON (and without "
          "EINSUMS_WITH_COVERAGE, which forces a static build)."
      )
    endif()
    message(STATUS "Einsums: static installation; stages and extension modules are unavailable")
  endif()
endif()

einsums_set_cmake_policy(CMP0144 NEW)

# Get the version number
set(EINSUMS_VERSION_STRING "@EINSUMS_VERSION@")
set(EINSUMS_VERSION_MAJOR @EINSUMS_VERSION_MAJOR@)
set(EINSUMS_VERSION_MINOR @EINSUMS_VERSION_MINOR@)
set(EINSUMS_VERSION_PATCH @EINSUMS_VERSION_PATCH@)

# Get the build type
set(EINSUMS_BUILD_TYPE "@EINSUMS_BUILD_TYPE@")

# We explicitly set the default to 98 to force CMake to emit a -std=c++XX flag.
# Some compilers (clang) have a different default standard for cpp and cu files,
# but CMake does not know about this difference. If the standard is set to the
# .cpp default in CMake, CMake will omit the flag, resulting in the wrong
# standard for .cu files.
set(CMAKE_CXX_STANDARD_DEFAULT 98)

set(EINSUMS_GIT_COMMIT
    "@EINSUMS_WITH_GIT_COMMIT@"
    CACHE STRING "Revision of einsums from Git" FORCE
)

set(EINSUMS_CXX_COMPILER
    "@CMAKE_CXX_COMPILER@"
    CACHE STRING "CXX compiler for einsums" FORCE
)
set(EINSUMS_CXX_COMPILER_ID
    "@CMAKE_CXX_COMPILER_ID@"
    CACHE STRING "CXX compiler id for einsums" FORCE
)
set(EINSUMS_CXX_COMPILER_VERSION
    "@CMAKE_CXX_COMPILER_VERSION@"
    CACHE STRING "CXX compiler version for einsums" FORCE
)

# Bounded on both sides, and matching Einsums_SetupFmt exactly. The old floor of
# 11 admitted the two releases that setup file exists to avoid: fmt 11.0.x trips
# a consteval FMT_STRING error under clang 22, and 11.1-11.2 call a bare
# malloc/free that macOS libc++ no longer exposes through <cstdlib>.
einsums_find_package(fmt 12...<13 REQUIRED)

# Stripes, the SIMD library: public Einsums headers (HPTT, PackedGemm) include its headers. A
# fetched Stripes is installed with Einsums, under the Einsums root; in a build tree it is in
# FetchContent's _deps (or wherever an installed Stripes was found), which the build-tree variant
# of this file substitutes, as for spdlog below.
set(_einsums_stripes_dir "@EINSUMS_BUILD_TREE_STRIPES_DIR@")
if(_einsums_stripes_dir)
  set(Stripes_DIR "${_einsums_stripes_dir}")
else()
  set(Stripes_ROOT "${_einsums_root_dir}")
endif()
unset(_einsums_stripes_dir)
einsums_find_package(Stripes 1 REQUIRED)

# Waggle, the profiler: Einsums links it and its public headers include Waggle's. It is installed
# with Einsums, under the Einsums root; in a build tree its config is in its own binary directory,
# which the build-tree variant of this file substitutes.
set(_einsums_waggle_dir "@EINSUMS_BUILD_TREE_WAGGLE_DIR@")
if(_einsums_waggle_dir)
  set(Waggle_DIR "${_einsums_waggle_dir}")
else()
  set(Waggle_ROOT "${_einsums_root_dir}")
endif()
unset(_einsums_waggle_dir)
einsums_find_package(Waggle 1.0 REQUIRED)

# Einsums/Logging.hpp is a PUBLIC header that includes <spdlog/...>, so a
# consumer compiles spdlog calls of its own - and those have to be compiled
# against the same headers Einsums was built with: either an installed spdlog
# it found, or one it built from source and folded into libEinsums (see
# Einsums_SetupSpdlog). Any other 1.x answering this find_package changes the
# layout of spdlog::logger under the consumer's feet, which is silent UB when it
# is not an outright compile error.
#
# So say where ours is and demand that exact version. spdlog_ROOT is searched
# ahead of CMAKE_PREFIX_PATH (CMP0074), which is what keeps a different spdlog
# in the surrounding environment from answering first.
#
# In an install tree it is under the Einsums root, put there by SPDLOG_INSTALL
# or by the package that provided it; in a build tree it is in FetchContent's
# _deps or wherever the installed one was found, so the build-tree variant of
# this file substitutes that path and the install-tree variant leaves it empty.
set(_einsums_vendored_spdlog_dir "@EINSUMS_BUILD_TREE_SPDLOG_DIR@")
if(_einsums_vendored_spdlog_dir)
  set(spdlog_ROOT "${_einsums_vendored_spdlog_dir}")
else()
  set(spdlog_ROOT "${_einsums_root_dir}")
endif()
unset(_einsums_vendored_spdlog_dir)
einsums_find_package(spdlog @EINSUMS_SPDLOG_VERSION@ EXACT REQUIRED)
# apiary::annotations is a usage requirement of einsums_public_flags, which every
# Einsums target links: Einsums/Python/Annotations.hpp is a shim over
# <apiary/Annotations.hpp>, and it is reached transitively from Logging.hpp. So
# this is needed even by a consumer that never touches Python. Header-only, and
# satisfied by an Apiary installed without the codegen tool.
einsums_find_package(Apiary 1...<2 REQUIRED CONFIG)
# mimalloc is a hard requirement of the allocation layer, and the exported
# internal targets name its target directly. Nothing here defines that target -
# a consumer never runs Einsums_SetupAllocator - so without this find_package
# the name stays a PLAIN library name and the link line asks for a bare
# "mimalloc" carrying no directory. A Unix link path resolves that by accident
# out of the surrounding prefix, which is why it went unnoticed; the Windows
# linker resolves it not at all, and an out-of-tree stage module is where that
# first shows up.
#
# No version request: mimalloc's installed config predates version-range
# support and reports a two-component version, so the rule Einsums enforces
# cannot be expressed here. Einsums_SetupAllocator already checked the header
# at build time, and a consumer linking the same install gets the same library.
einsums_find_package(mimalloc REQUIRED CONFIG)
if(NOT TARGET @EINSUMS_MIMALLOC_TARGET@)
  message(
    FATAL_ERROR
      "Einsums was built against the '@EINSUMS_MIMALLOC_TARGET@' mimalloc target, which the mimalloc "
      "package found at '${mimalloc_DIR}' does not define. A source-built mimalloc supplies both "
      "'mimalloc' and 'mimalloc-static'; an installed one may supply only the shared target. Install a "
      "mimalloc that carries it, or rebuild Einsums against the one this environment has."
  )
endif()
einsums_find_package(TargetHDF5 REQUIRED)
einsums_find_package(OpenMP MODULE COMPONENTS CXX)

if (NOT TARGET tgt::lapack)
  if (@EINSUMS_LINALG_VENDOR@ STREQUAL MKL)  # EINSUMS_LINALG_VENDOR
    add_library(tgt::lapack INTERFACE IMPORTED)
    set(MKL_INTERFACE @EINSUMS_LINALG_INT_INTERFACE@)  # EINSUMS_LINALG_INT_INTERFACE
    find_package(MKL CONFIG ${extraArgs})
    set_property(TARGET tgt::lapack PROPERTY INTERFACE_LINK_LIBRARIES MKL::MKL)
  else ()
    # Run the search the build ran instead of replaying the vendor it recorded. The recorded vendor
    # is the name the build asked for, and when that is All, FindBLAS on macOS picks the SDK's
    # Accelerate ahead of the environment's libblas that libEinsums links. Hold the search to the
    # integer width libEinsums was built with and off MKL, which it does not link. A BLA_VENDOR set
    # by the consumer still chooses.
    set(TargetLAPACK_INT_INTERFACE @EINSUMS_LINALG_INT_INTERFACE@)  # EINSUMS_LINALG_INT_INTERFACE
    set(TargetLAPACK_SKIP_MKL TRUE)
    einsums_find_package(TargetLAPACK MODULE REQUIRED)
    unset(TargetLAPACK_INT_INTERFACE)
    unset(TargetLAPACK_SKIP_MKL)
  endif ()
  set(EINSUMS_@EINSUMS_LINALG_INT_INTERFACE@_FOUND 1)
endif ()

if (@EINSUMS_FFT_LIBRARY@ STREQUAL mkl)  # EINSUMS_FFT_LIBRARY
  if (@EINSUMS_LINALG_VENDOR@ STREQUAL MKL)  # EINSUMS_LINALG_VENDOR
    add_library(FFT::FFT ALIAS tgt::lapack)
  endif ()
elseif (@EINSUMS_FFT_LIBRARY@ STREQUAL fftw3)  # EINSUMS_FFT_LIBRARY
  find_package(FFTW MODULE COMPONENTS FLOAT_LIB DOUBLE_LIB ${extraArgs})
  add_library(FFT::FFT INTERFACE IMPORTED)
  target_link_libraries(FFT::FFT INTERFACE FFTW::Float FFTW::Double)
endif ()

# Look for Python dependencies ... I'm not entirely sure this is needed
# since the Python module is just consumed and not compiled again.
if (@EINSUMS_BUILD_PYTHON@)
  find_package(
          Python3
          COMPONENTS Interpreter Development
          REQUIRED
  )
  # The binding library einsums._core was built with, its exact release, and
  # whether it was built against the stable ABI, exported so a stage module is
  # built the same way: an out-of-tree module receives RuntimeTensors that
  # einsums._core created, and both pybind11 and nanobind share types only
  # between modules whose internals agree. nanobind's internals identifier
  # includes the stable-ABI mode, so that has to match too. Disagree and the
  # module gets a private type registry, and the failure surfaces as
  # "incompatible function arguments" at call time rather than as anything
  # diagnosable at load time.
  set(Einsums_PYTHON_BACKEND "@APIARY_BACKEND@")
  set(Einsums_PYTHON_BACKEND_VERSION "@APIARY_BACKEND_VERSION@")
  set(Einsums_PYTHON_STABLE_ABI @APIARY_STABLE_ABI@)
  # The language level Einsums itself was compiled at, exported so a stage
  # module can match it without guessing. Not cosmetic: a module compiled at a
  # different standard folds a different __cplusplus into config_fingerprint()
  # and is refused at import by einsums.sealed - and worse, it may fail to
  # dlopen outright on a template instantiation this library never emitted,
  # which happens before any handshake gets to explain itself.
  set(Einsums_CXX_STANDARD "@EINSUMS_WITH_CXX_STANDARD@")
  # apiary finds the library and builds stage modules with it
  # (einsums_add_stage_module); the Apiary found above may be one that only
  # provides the annotations, but 1.4 ships these helpers with them.
  if(NOT COMMAND apiary_find_backend)
    message(FATAL_ERROR "Einsums: building against its Python package needs Apiary 1.4 or newer, "
                        "which finds the binding library; the Apiary found (${Apiary_DIR}) predates it.")
  endif()
  set(APIARY_STABLE_ABI ${Einsums_PYTHON_STABLE_ABI})
  apiary_find_backend(BACKEND ${Einsums_PYTHON_BACKEND} VERSION ${Einsums_PYTHON_BACKEND_VERSION} EXACT)
endif ()

# A CUDA build's consumers need the CUDA toolkit's imported targets.
if(@EINSUMS_WITH_CUDA@)
  set(EINSUMS_WITH_CUDA_ARCHITECTURES "@EINSUMS_WITH_CUDA_ARCHITECTURES@")
  include(Einsums_SetupCUDA)
endif()

if (NOT EINSUMS_CMAKE_LOGLEVEL)
  set(EINSUMS_CMAKE_LOGLEVEL "WARN")
endif ()

einsums_check_compiler_compatibility()

# Since we offer Einsums::Einsums, Einsums::EinsumsPy, and Einsums::EinsumsExperimental
# we need to let the user ask for COMPONENTS and then ensure we have everything needed
# for the specified COMPONENT and set Einsums_FOUND to TRUE or FALSE
if (TARGET Einsums::Einsums)
  set(Einsums_FOUND TRUE)
endif ()

if (NOT DEFINED ${CMAKE_FIND_PACKAGE_NAME}_FOUND)
  set(${CMAKE_FIND_PACKAGE_NAME}_FOUND TRUE)
endif ()

# Generated by the libs/create_module_skeleton package. The module list is in dependency order and
# the order is yours: the generator keeps it, drops modules that are gone, and appends new ones.
# Move a new module earlier when a module already listed needs it at configure time.

include(Einsums_Message)

{preamble}

# cmake-format: off
set(_{lib_name}_modules
  {modules}
)
# cmake-format: on

einsums_info("")
einsums_info("  Configuring {lib_name} modules:")

foreach(module ${{_{lib_name}_modules}})
  einsums_info("    ${{module}}")
  add_subdirectory(${{module}})
endforeach()

{closer}

// Do not edit this file! It has been generated by the cmake configuration step.

#pragma once

// The git identity of this build, deliberately NOT reachable from any public
// header. These values change on every commit, so a macro that every
// translation unit parsed would hand every translation unit a new preprocessor
// fingerprint on every commit: ccache's direct mode would never match its
// manifest again, and each push would orphan the entire object cache rather
// than just the objects it actually invalidated.
//
// This is the same reasoning that moved the build timestamp out of
// ConfigVersion.hpp.in and into the compiler's date and time macros in one
// translation unit. Those macros are not spelled out here either: ccache
// disables direct mode for any translation unit whose included text mentions
// them, comments included.
// Exactly one translation unit includes this file, Config/src/Version.cpp, and
// the values reach the rest of the library through the accessors declared in
// <Einsums/Config/Version.hpp>.

#define EINSUMS_GIT_COMMIT_STRING "@EINSUMS_WITH_GIT_COMMIT@"
#define EINSUMS_GIT_BRANCH_STRING "@EINSUMS_WITH_GIT_BRANCH@"
#define EINSUMS_GIT_DIRTY_FLAG    @EINSUMS_WITH_GIT_DIRTY@
